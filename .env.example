# WhatsApp Sender Configuration
# ------------------------------

# Database (Leave as is for SQLite inside Docker)
DATABASE_URL="file:./dev.db"

# NextAuth Security (Change this to a random string)
NEXTAUTH_SECRET="your_secure_random_string_here"
NEXTAUTH_URL="http://localhost:3000"

# Application Branding (White-labeling)
NEXT_PUBLIC_APP_NAME="Smart WA Sender"
NEXT_PUBLIC_APP_DESC="نظام إرسال الرسائل الذكي وإدارة الحملات"
NEXT_PUBLIC_COPYRIGHT="2025 جميع الحقوق محفوظة"
NEXT_PUBLIC_LOGO_URL="/icon.png"

# Port (Optional, default is 3000)
PORT=3000
